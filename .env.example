# このファイルを .env にコピーして値を設定してください
# cp .env.example .env

# 初期管理者(admin)のパスワード。未設定なら初回起動時にランダム生成され、
# 起動ログに一度だけ表示されます(どちらの場合もログイン後の変更を推奨)
ADMIN_PASSWORD=

# HTTPSリバースプロキシ(nginx等)の背後で動かす場合は 1 を設定。
# セッションCookieに Secure 属性が付き、平文HTTPでは送信されなくなります
COOKIE_SECURE=1

# セッション署名キー。未設定なら起動ごとにランダム生成されます(通常は未設定でOK)
SECRET_KEY=
